# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 커밋되지 않는다.
#
# 검색어 트렌드 키. BE/analysis/fetch_trend_category.py 만 쓴다(서버 실행에는 필요 없다).
# 2026-07-31 부로 네이버 개발자센터는 신규 등록이 막혔다. 새로 받으려면
# 네이버 클라우드 플랫폼 콘솔 > NAVER API HUB 에서 '검색어 트렌드' 를 신청해 Client ID / Secret 을 받는다.
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# 서버가 설문 사진 URL 을 만들 때 쓰는 공개 주소(선택). 기본 http://localhost
MATCHURI_MEDIA_PUBLIC_BASE_URL=http://localhost
